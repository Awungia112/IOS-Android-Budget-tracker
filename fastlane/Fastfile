# encoding: utf-8
# Fastlane configuration for Budget Wise Mobile Apps
# Android: Play Store | iOS: App Store & TestFlight
#
# Production-ready with improved error handling, validation, and DevOps practices
#
# Environment Variables Required:
# ================================
# iOS:
#   MATCH_PASSWORD                    - Password for encrypting certificates
#   APP_STORE_CONNECT_API_KEY_ID      - App Store Connect API key ID
#   APP_STORE_CONNECT_API_ISSUER_ID   - App Store Connect issuer ID
#   APP_STORE_CONNECT_API_KEY         - App Store Connect API key content (base64)
#   APPLE_TEAM_ID                     - Apple Team ID
#   SLACK_WEBHOOK_URL (optional)      - For notifications
#   BETA_CONTACT_EMAIL (optional)     - TestFlight beta contact
#   BETA_CONTACT_PHONE (optional)     - TestFlight beta contact
#
# Android:
#   GOOGLE_PLAY_JSON_KEY_FILE         - Path to service account JSON
#
# Optional (for enhanced logging):
#   BUILD_VERSION                     - Version number (defaults to git tag)
#   CHANGELOG_FILE                    - Path to changelog (defaults to git log)

# =======================
# CONFIGURATION
# =======================

default_platform(:ios)

# Constants
APP_IDENTIFIER = ENV["APP_IDENTIFIER"] || "de.deutschland-im-plus.MeinBudget"
APPLE_TEAM_ID = ENV["APPLE_TEAM_ID"]
IPA_OUTPUT_DIR = "build"
BETA_CONTACT_EMAIL = ENV["BETA_CONTACT_EMAIL"] || "dipbudgetapp@gmail.com"
BETA_CONTACT_PHONE = ENV["BETA_CONTACT_PHONE"].to_s
MATCH_PASSWORD = ENV["MATCH_PASSWORD"]
GIT_AUTH_TOKEN = ENV["GIT_AUTH_TOKEN"]
KEY_PATH = ENV["GOOGLE_PLAY_JSON_KEY_PATH"]
AAB_PATH = ENV["ANDROID_AAB_PATH"]
APK_PATH = ENV["ANDROID_APK_PATH"]
# SLACK_WEBHOOK = ENV["SLACK_WEBHOOK_URL"] not necessary now

# =======================
# VALIDATION & SETUP
# =======================

def validate_environment
  UI.header("🔍 Validating environment variables...")

  required_ios_vars = %w[
    APP_STORE_CONNECT_API_KEY_ID
    APP_STORE_CONNECT_API_ISSUER_ID
    APP_STORE_CONNECT_API_KEY
    APPLE_TEAM_ID
    MATCH_PASSWORD
  ]

  required_ios_vars << "GIT_AUTH_TOKEN" if is_ci

  missing_vars = required_ios_vars.select { |var| ENV[var].to_s.empty? }

  if missing_vars.any?
    UI.error("❌ Missing required environment variables:")
    missing_vars.each { |var| UI.error("   - #{var}") }
    raise "Missing environment variables: #{missing_vars.join(', ')}"
  end

  UI.success("✅ All required environment variables present")
end

def get_build_metadata
  commit_hash = sh("git rev-parse --short HEAD").strip
  branch = sh("git rev-parse --abbrev-ref HEAD").strip
  timestamp = Time.now.to_i
  commit_message = sh("git log -1 --pretty=%B").strip

  # Use CI_COMMIT_TAG in tag pipelines (available in GitLab CI),
  # fall back to git describe for local/non-tag builds
  # Remove leading 'v' from tag for consistent version format
  tag = (ENV["CI_COMMIT_TAG"] || sh("git describe --tags --always 2>/dev/null || echo #{commit_hash}").strip).sub(/^v/, "")
  {
    commit_hash: commit_hash,
    branch: branch,
    timestamp: timestamp,
    commit_message: commit_message,
    tag: tag
  }
end

def generate_changelog
  if File.exist?("CHANGELOG.md")
    UI.message("📄 Using CHANGELOG.md for release notes")
    return File.read("CHANGELOG.md").lines.take(20).join # First 20 lines
  else
    # Fallback: last 10 commits
    UI.message("📜 Generating changelog from last 10 git commits")
    return sh("git log --oneline -10").strip
  end
rescue StandardError => ex
   UI.error("❌ Failed to generate changelog: #{ex.class} - #{ex.message}")
   UI.error("⚠️ Falling back to minimal changelog")

   metadata = get_build_metadata
   return "Build from commit #{metadata[:tag]} (#{metadata[:commit_hash]})"
end

