{
  "model": {
    "review_model": "glm-5p1",
    "summary_model": "gemma-4"
  },
  "context": {
    "max_tokens": 64000,
    "output_reserve_tokens": 16000,
    "summarizer_concurrency": 8
  },
  "index": {
    "db_path": ".snif/index.db",
    "embedding_dimension": 384,
    "exclude_patterns": [
      "target",
      "node_modules",
      "vendor",
      ".git",
      "dist",
      "build",
      ".gradle",
      ".mvn",
      "coverage",
      "android",
      "ios"
    ]
  },
  "review": {
    "max_files": 50,
    "ignore_patterns": [
      "pnpm-lock.yaml",
      "*.config.js",
      "*.config.cjs",
      "*.config.ts",
      "dist/**",
      "coverage/**",
      "node_modules/**",
      "android/**",
      "ios/**"
    ]
  }
}
