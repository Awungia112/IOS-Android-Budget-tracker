<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
             Sentry DSN — injected at build time via manifestPlaceholders in
             app/build.gradle.  Leave the placeholder empty and Sentry will
             simply not initialise (safe for local / unsigned builds).
        -->
        <meta-data android:name="io.sentry.dsn" android:value="${sentryDsn}" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                 Separate intent-filter for the custom scheme.
                 IMPORTANT: Must be in its own filter. Mixing a bare-scheme
                 data element with scheme+host data elements in a single
                 filter causes Android to AND the attributes on some versions,
                 preventing the custom scheme from matching.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="budgetwise" />
            </intent-filter>
            <!--
                 Android App Links intent filter for the production API domain.
                 android:autoVerify="true" tells the system to verify the association
                 with assetlinks.json on api.prod.dip.on.adorsys.com.
                 No path restriction here - path-level routing is handled server-side
                 in assetlinks.json (Android 15+ dynamic rules) and the server's own
                 route handling.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="api.prod.dip.on.adorsys.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
