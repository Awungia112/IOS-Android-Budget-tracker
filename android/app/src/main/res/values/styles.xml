<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
            Explicit window background colour matching the app shell (#3A464F).
            Without this the native window defaults to black, which bleeds through
            as a visible black band between the WebView content and the on-screen
            keyboard while the WebView is resizing on Android.
        -->
        <item name="android:windowBackground">#3A464F</item>
        <!-- Android 15 (API 35+): Opt-out of forced edge-to-edge on WebView -->
        <!-- Edge handling is controlled via capacitor.config.ts plugins -->
        <!-- (StatusBar.overlaysWebView, EdgeToEdge, and SystemBars settings) -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>