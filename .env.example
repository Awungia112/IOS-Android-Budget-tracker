# Optional Docker Compose overrides.
# Copy this file to .env at the repository root when running backend containers
# through `pnpm stack:server` or `pnpm stack:recovery`.
#
# Do not commit .env. Real Brevo keys and local secrets belong only in ignored
# local env files or environment variables.

# ---------------------------------------------------------------------------
# Sentry crash & error monitoring (ticket #442)
# ---------------------------------------------------------------------------
#
# VITE_SENTRY_DSN — Sentry Data Source Name for the JS / Capacitor WebView layer.
#   Leave empty (or unset) in local development to disable Sentry entirely.
#   Set in CI/CD for staging and production builds.
#   Find the DSN in your Sentry project → Settings → Client Keys.
#
# SENTRY_AUTH_TOKEN — used by the Sentry Gradle plugin to upload ProGuard
#   mapping files so minified Android stack traces are human-readable.
#   Generate a token at https://sentry.io/settings/account/api/auth-tokens/
#   (scope: project:releases, org:read, project:write).
#   Only required in the Android release CI job.
#
# SENTRY_DSN — same DSN value used by the Android native SDK via
#   manifestPlaceholders in android/app/build.gradle.
#   Required in Android release CI; safe to leave unset locally.
#
# Hosting / GDPR note:
#   Sentry can be self-hosted (EU region) or SaaS (sentry.io).
#   For GDPR compliance, consider an EU-region Sentry organisation or a
#   self-hosted instance.  See docs/decisions/adr-sentry-hosting.md.
#
# VITE_SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>
#
# VITE_SENTRY_DEBUG — set to 'true' to show the in-app Sentry debug panel
# (Settings page). Omit in staging and production — the component is
# tree-shaken when this flag is absent or not exactly 'true'.
# VITE_SENTRY_DEBUG=true

# ---------------------------------------------------------------------------
# Duplicate-migration remediation (ticket #462)
# ---------------------------------------------------------------------------
#
# VITE_ENABLE_REMEDIATION_PHASE2 — build-time flag that selects which remediation
#   phase ships in the app bundle.
#   - unset / not exactly 'true'  → Phase 1 (detect-only): scans the ChangeLog and
#     reports content-free aggregate stats to Sentry. Zero mutation.
#   - 'true'                      → Phase 2 (detect-and-act): soft-archives flagged
#     duplicate rows and appends UPDATE_* ChangeLog commands.
#
#   This is a Vite env var, so it is baked into the static assets at build time and
#   requires a rebuild + redeploy to change. See docs/remediation-phase2.md.
#
#   Staged rollout: ship Phase 1 broadly first, validate the 60s cluster threshold
#   via Phase 1 telemetry, then enable Phase 2 (staging → production).
# VITE_ENABLE_REMEDIATION_PHASE2=true

MAGIC_LINK_SECRET=replace-with-local-dev-secret
# MAGIC_LINK_TEMPLATE_ID — unset to use the inline HTML email builder (supports i18n).
# Set to a Brevo template ID only if the template handles language switching itself.
# MAGIC_LINK_TEMPLATE_ID=
# INVITE_TEMPLATE_ID — unset to use the inline HTML email builder (supports i18n).
# Set to a Brevo template ID only if the template handles language switching itself.
# INVITE_TEMPLATE_ID=
AUTH_DEEP_LINK_BASE=http://127.0.0.1:3095/v1/auth/verify

RECOVERY_JWT_SECRET=replace-with-local-recovery-jwt-secret
# IMPORTANT: RECOVERY_EMAIL_PEPPER must equal BUDGET_WISE_PEPPER on the main server.
# Both servers hash the email with the same pepper — if they differ, recovery will
# always return "email not registered" even for enrolled accounts.
RECOVERY_EMAIL_PEPPER=replace-with-local-recovery-email-pepper
# RECOVERY_EMAIL_TEMPLATE_ID — unset to use the inline HTML email builder (supports i18n).
# Set to a Brevo template ID only if the template handles language switching itself.
# RECOVERY_EMAIL_TEMPLATE_ID=
RECOVERY_DEBUG=false

# Feedback email recipients.
FEEDBACK_RECIPIENT_PRIMARY=mobilebudget@deutschland-im-plus.de
FEEDBACK_RECIPIENT_BACKUP=info@deutschland-im-plus.de

# Required by the server for email encryption. Generate a local key with:
#   openssl rand -hex 32
# Then set it in your local .env file (not .env.example).
# EMAIL_ENCRYPTION_KEY=

# Required only for real email delivery tests.
BREVO_API_KEY=replace-with-brevo-transactional-api-key
# Required when template IDs are unset — must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Mein Budget
