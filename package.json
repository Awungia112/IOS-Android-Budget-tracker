{
  "name": "budget-wise-pwa",
  "private": true,
  "version": "4.6.1",
  "description": "My Budget - Expenses under control PWA",
  "type": "module",
  "scripts": {
    "dev": "nx serve app",
    "dev:server": "nx serve server",
    "stack:db": "docker compose up -d postgres recovery-postgres",
    "stack:server": "docker compose --profile server up --build server",
    "stack:recovery": "docker compose --profile recovery up --build recovery-server",
    "stack:tools": "docker compose --profile tools up -d adminer",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "db:migrate:server:local": "DATABASE_URL=postgresql://budget:budget@localhost:55432/budget pnpm --filter @budget/server run db:migrate",
    "db:migrate:recovery:local": "RECOVERY_DB_URL=postgresql://budget_recovery:budget_recovery@localhost:55433/budget_recovery pnpm --filter @budget/recovery-server run db:migrate",
    "build": "nx run-many -t build",
    "build:dev": "nx build app --mode development",
    "lint": "nx run-many -t lint",
    "typecheck": "nx build core && nx run-many -t typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "pnpm --filter @budget/app run test:e2e",
    "test:e2e:ui": "pnpm --filter @budget/app run test:e2e:ui",
    "test:e2e:report": "pnpm --filter @budget/app exec playwright show-report",
    "test:lighthouse": "pnpm --filter @budget/app run test:lighthouse",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "preview": "nx preview app",
    "graph": "nx graph",
    "knip": "knip",
    "release": "bash scripts/release.sh",
    "release:dry": "bash scripts/release.sh --dry-run",
    "release:ci": "bash scripts/test-release.sh",
    "smoke:ios-coredata:seed": "bash scripts/seed-ios-coredata-smoke.sh",
    "test:schema": "ajv validate -s packages/core/src/migration/local/migration-schema.json -d packages/core/src/migration/local/sample-payload.json -c ajv-formats --strict=false",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.5",
    "@capawesome/capacitor-file-picker": "8.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.0.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^6.30.3",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@budget/core": "workspace:*",
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@eslint/js": "^9.9.0",
    "@nx/eslint": "^20.0.0",
    "@nx/vite": "^20.0.0",
    "@release-it/conventional-changelog": "^10.0.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^2.1.3",
    "@vitest/ui": "^2.1.3",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-security": "^4.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.83.0",
    "msw": "^2.12.10",
    "nx": "^20.0.0",
    "postcss": "^8.5.3",
    "release-it": "^19.2.4",
    "stylelint": "^16.19.1",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^2.1.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "basic-ftp@<5.2.0": "5.2.0",
      "axios@>=1.0.0 <=1.13.4": "1.13.6",
      "@isaacs/brace-expansion@<=5.0.0": "5.0.1",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4"
    }
  }
}
