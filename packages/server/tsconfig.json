{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest/globals"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "allowJs": false,
    "isolatedModules": false,
    "noEmit": false,
    "paths": {
      "@budget/shared/session-token": ["../shared/src/session-token.ts"],
      "@budget/shared/sync-limits": ["../shared/src/sync-limits.ts"],
      "@budget/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../core" }, { "path": "../shared" }],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
