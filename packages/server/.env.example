# @budget/server local environment example.
# Copy this file to packages/server/.env for local development.

# Required for migrations and server startup.
DATABASE_URL=postgresql://budget:budget@localhost:55432/budget

# Required for server startup because @fastify/jwt is registered at app boot.
# Use a local-only random string. Do not reuse production secrets.
MAGIC_LINK_SECRET=replace-with-local-dev-secret

# Secret pepper used for email hashing. Must match the client-side pepper
# if hashing is performed on both sides, or at least be stable for lookups.
BUDGET_WISE_PEPPER=replace-with-stable-pepper

# Required only when testing POST /v1/auth/register all the way through Brevo email delivery.
# Leave as a placeholder unless you are doing a real provider smoke test.
BREVO_API_KEY=replace-with-brevo-transactional-api-key

# Required for real Brevo delivery when MAGIC_LINK_TEMPLATE_ID is not set.
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Mein Budget

# Optional. When set, Brevo sends this transactional template and receives params:
# magic_link and code. When empty, the server sends its built-in inline HTML email
# content which supports German and English based on the app language.
# MAGIC_LINK_TEMPLATE_ID — unset to use the inline HTML email builder (supports i18n).
# Set to a Brevo template ID only if the template handles language switching itself.
# MAGIC_LINK_TEMPLATE_ID=

# Optional. Brevo template for account invitation emails.
# When not set, the server falls back to inline HTML.
# INVITE_TEMPLATE_ID — unset to use the inline HTML email builder (supports i18n).
# Set to a Brevo template ID only if the template handles language switching itself.
# INVITE_TEMPLATE_ID=

# Deep-link base for magic-link emails. The fallback is the production domain
# (api.prod.dip.on.adorsys.com). Override for local tests:
#   AUTH_DEEP_LINK_BASE=http://localhost:8080/register/verify
# or for dev/staging environments.
AUTH_DEEP_LINK_BASE=https://api.prod.dip.on.adorsys.com/register/verify

# Optional. Feedback email recipients (defaults shown).
FEEDBACK_RECIPIENT_PRIMARY=mobilebudget@deutschland-im-plus.de
FEEDBACK_RECIPIENT_BACKUP=info@deutschland-im-plus.de

# The email encryption key is required for encrypting email fields in the database
# (account_members.displayEmail) so no plaintext email is persisted.
# Generate a 64-character hex string (32 bytes for AES-256):
#
#   openssl rand -hex 32
#
# EMAIL_ENCRYPTION_KEY=

# Optional. Required for production Universal Links / App Links verification.
# APPLE_TEAM_ID is found in Apple Developer Portal > Membership (10-char alphanumeric).
# ANDROID_SHA256_FINGERPRINT is the SHA-256 fingerprint of the production signing certificate
# (for Play Store builds, use the Play App Signing key, not the upload key).
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINT=

# Optional runtime defaults.
HOST=127.0.0.1
PORT=3095
NODE_ENV=development
