# @budget/recovery-server local environment example.
# Copy this file to packages/recovery-server/.env for local development.

# Required for migrations and recovery-server startup.
# This database must stay separate from packages/server's DATABASE_URL.
RECOVERY_DB_URL=postgresql://budget_recovery:budget_recovery@localhost:55433/budget_recovery

# Required for recovery token signing.
# Use a local-only random string. Do not reuse production secrets.
RECOVERY_JWT_SECRET=replace-with-local-recovery-jwt-secret

# Required for recovery email hashing.
# IMPORTANT: RECOVERY_EMAIL_PEPPER must equal BUDGET_WISE_PEPPER on the main server.
# Both servers hash the email with the same pepper — if they differ, recovery will
# always return "email not registered" even for enrolled accounts.
RECOVERY_EMAIL_PEPPER=replace-with-local-recovery-email-pepper

# Required for real recovery-code email delivery.
# Leave as a placeholder unless you are doing a real provider smoke test.
BREVO_API_KEY=replace-with-brevo-transactional-api-key

# Required for inline email delivery (when RECOVERY_EMAIL_TEMPLATE_ID is not set).
# Must be a verified sender address in your Brevo account.
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Mein Budget

# Optional. Brevo transactional template ID for recovery code emails.
# When not set, the server uses the inline HTML email builder (supports German + English).
# Set only if the Brevo template handles language switching itself.
# RECOVERY_EMAIL_TEMPLATE_ID=

# Optional local-only helper for manual recovery testing.
RECOVERY_DEBUG=false

# Optional runtime defaults.
HOST=127.0.0.1
PORT=3096
NODE_ENV=development
