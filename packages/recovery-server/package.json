{
  "name": "@budget/recovery-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -e \"const e = process.env; if (!e.RECOVERY_DB_URL && !(e.DB_HOST && e.DB_PORT && e.DB_USER && e.DB_PASSWORD)) { console.error('RECOVERY_DB_URL or DB_HOST/DB_PORT/DB_USER/DB_PASSWORD must be set to run Drizzle migrations'); process.exit(1) }\" && drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "10.2.2",
    "@getbrevo/brevo": "^5.0.0",
    "argon2": "0.43.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "libsodium-wrappers": "^0.8.4",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@budget/core": "workspace:*",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "22.19.15",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
