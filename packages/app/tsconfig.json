{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@budget/core": ["../core/src/index.ts"],
      "@budget/shared/session-token": ["../shared/src/session-token.ts"],
      "@budget/shared/sync-limits": ["../shared/src/sync-limits.ts"],
      "@budget/shared": ["../shared/src/index.ts"]
    },
    "types": ["@testing-library/jest-dom", "vitest/globals", "node"]
  },
  "include": ["src/**/*", "src/**/*.json", "vite.config.ts", "vitest.setup.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../core" }, { "path": "../shared" }]
}
