@startuml Frontend_Architecture
skinparam componentStyle uml2

title Budget Wise PWA - Frontend Architecture

component "User" as user

component "@budget/app \n" #moccasin {
    component "Pages" as pages #lightyellow
    component "Components" as components #lightyellow
    component "Hooks" as hooks #lightyellow
    component "Contexts" as contexts #lightyellow
    interface "State API" as stateapi #white

    pages ..> hooks : use
    components ..> hooks : use
    hooks ..> contexts : consume
    contexts - stateapi
}

component "@budget/core \n" {
    component "Types" as types #white
    component "Services" as services #white
    component "Repositories" as repos #white
    component "Connection\nManager" as connmgr #lightblue
    interface "Core API" as coreapi #white
    interface "DB API" as dbapi #white

    coreapi - services
    services ..> types : use
    services ..> repos : use
    repos ..> connmgr : use
    connmgr - dbapi
}

component "Browser Storage \n" #moccasin {
    component "IndexedDB" as indexeddb #lightyellow
}

component "Service Worker \n" #lightblue {
    component "Cache Storage\nAPI" as cachestorage #lightcyan
}

user ..> pages : interact
stateapi ..> coreapi : import
dbapi ..> indexeddb : persist
cachestorage ..> pages : serve offline

note right of contexts
  State Management
  React Context API
  No Event Bus
end note

note right of connmgr
  Singleton Pattern
  Single Connection
  Auto Reconnect
end note

note right of indexeddb
  Business data storage:
  7 Object Stores:
  accounts, transactions,
  categories, limits,
  templates, recurringItems,
  savingsGoals
end note

note right of cachestorage
  Infrastructure caching:
  HTML, CSS, JS, images
  Uses Cache Storage API
  (NOT IndexedDB)
end note

@enduml
